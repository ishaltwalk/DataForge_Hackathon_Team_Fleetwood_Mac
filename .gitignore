# ==========================
# Secrets & Environment
# ==========================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# ==========================
# Python & Bytecode
# ==========================
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg

# Python build/packaging output.
# NOTE: these are anchored with a leading slash on purpose. An unanchored
# "lib/" matches at ANY depth, which is how src/lib/ (the front end's api.js
# and recorder.js) was silently excluded from every commit and the React app
# would not build from a fresh clone. Do not remove the slashes.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing, typing & linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==========================
# Audio / Media Artifacts
# ==========================
*.wav
*.mp3
*.ogg
*.opus
*.flac
*.m4a
*.mulaw
audio_output/
generated_clips/
recordings/

# Written by server.py inspect_upload() on every attempt. Local debug aid,
# and it contains a recording of whoever last used the machine.
debug_last_attempt.wav

# Scratch output from rime_tts/manual_check_*.py
output.wav
ref_rhyme.wav
round_trip.wav

# Exception: evidence clips ARE the acceptance fixtures and must be committed.
!evidence/clips/**
!fixtures/**/*.wav
!fixtures/**/*.mp3

# ==========================
# Node / Frontend
# ==========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
out/
.turbo/
.vite/
*.tsbuildinfo
.eslintcache

# ==========================
# Agent / editor scaffolding
# ==========================
# .agents/skills/* was a symlink into .venv on one Windows machine. It is
# broken on every other clone.
.agents/

# ==========================
# Logs & System Cache
# ==========================
*.log
logs/
.cache/
.DS_Store
Thumbs.db
desktop.ini

# ==========================
# IDEs & Editors
# ==========================
.vscode/
.idea/
*.swp
*.swo

# ==========================
